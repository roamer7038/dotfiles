#!/bin/bash
#
# 複数ホストへ同時に SSH し、tmux のペイン分割で一括操作する。
# ペインはタイル状に並び、synchronize-panes が有効な状態で始まる。
#
#   multissh 192.168.1.1 192.168.1.2
#   multissh web{1..3}.example.com
#   SESSION_NAME=myservers multissh host1 host2
#
# セッション名の既定は multi-ssh-<timestamp>。
# 同期の解除は Ctrl+b :setw synchronize-panes off。
#
# 原作: @mikeda / 改変: @roamer7038

if [ $# = 0 ]; then
  echo "usage: $(basename "$0") <destination>"
  echo "examples: $(basename "$0") 192.168.1.{1-4}"
  echo "          $(basename "$0") 192.168.1.1 192.168.1.2"
  exit 1
fi

if [ -n "$SESSION_NAME" ]; then
  session=$SESSION_NAME
else
  session=multi-ssh-$(date +%s)
fi

window=multi-ssh

# --- セッションの作成と接続 ---

# デタッチ状態で作り、全ホストを繋いでから最後にアタッチする
tmux new-session -d -n $window -s $session

# 最初のホストは分割せず、既にあるペインで繋ぐ
tmux send-keys "ssh $1" C-m
shift

for i in $*; do
  tmux split-window

  # 分割のたびに並べ直し、最後まで均等な配置を保つ
  tmux select-layout tiled

  tmux send-keys "ssh $i" C-m
done

# --- 同期モードとアタッチ ---

tmux select-pane -t 0

# 全ペインへ同じキー入力を送る
tmux set-window-option synchronize-panes on

tmux attach-session -t $session
