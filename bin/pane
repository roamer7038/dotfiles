#!/bin/bash
#
# tmux のペインを指定した数だけ分割し、tiled レイアウトで均等に並べる。
#
#   pane 4      4分割
#   pane -s 6   6分割し synchronize-panes を有効化
#
# 原作: @rksz / 改変: @roamer7038

usage() {
  CMDNAME=$(basename $0)
  echo "usage: $CMDNAME [-s] pane_num" 1>&2
}

main() {
  # --- オプション解析 ---

  while getopts :s opt; do
    case $opt in
    "s") readonly FLG_S="TRUE" ;;
    *)
      usage
      exit 1
      ;;
    esac
  done

  shift $(expr $OPTIND - 1)

  # --- ペインの分割 ---

  if [ $1 ]; then
    # 起動時点で1つあるので、そこから指定数まで足す
    cnt_pane=1

    while [ $cnt_pane -lt $1 ]; do
      if [ $(($cnt_pane & 1)) ]; then
        tmux split-window -h
      else
        tmux split-window -v
      fi

      # 分割のたびに並べ直し、最後まで均等な配置を保つ
      tmux select-layout tiled 1>/dev/null

      cnt_pane=$(($cnt_pane + 1))
    done
  fi

  # --- 同期モード ---

  # 全ペインへ同じキー入力を送る
  if [ "$FLG_S" = "TRUE" ]; then
    tmux set-window-option synchronize-panes 1>/dev/null
  fi
}

main "$@"
